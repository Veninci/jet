# --- Application ---
DATABASE_URL="postgresql://postgres@localhost:5432/emptyleg"
# URL publique canonique (sans slash final) : sert au sitemap, aux balises canonical, aux e-mails
SITE_URL="http://localhost:3000"
# "production" désactive définitivement le catalogue de démonstration
APP_ENV="development"
# Afficher le catalogue fictif (ignoré si APP_ENV=production)
DEMO_CATALOG="true"
# Secret de signature des sessions admin (32+ caractères aléatoires : openssl rand -base64 48)
AUTH_SECRET="change-me-change-me-change-me-change-me"

# --- E-mails transactionnels (Resend). Sans clé : les e-mails sont journalisés dans la console. ---
RESEND_API_KEY=""
EMAIL_FROM="Aelys <demandes@example.com>"
SALES_NOTIFICATION_EMAIL="commercial@example.com"

# --- Mesure (chargée uniquement après consentement) ---
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""

# --- Avinode (requiert une adhésion Marketplace + accès API validé par Avinode) ---
AVINODE_API_BASE=""
AVINODE_API_TOKEN=""
AVINODE_BEARER_TOKEN=""
AVINODE_PRODUCT_HEADER="Aelys Web/0.1"
AVINODE_ACT_AS_ACCOUNT=""

# --- API mobile (Rork / Expo) ---
# Origines navigateur autorisées (Expo Web, aperçu Rork), séparées par des virgules. Les apps natives n'en ont pas besoin.
API_CORS_ORIGINS=""
# Délai de réponse affiché aux clients (n'afficher qu'un engagement tenable), ex. "sous 2 heures ouvrées"
NEXT_PUBLIC_RESPONSE_TIME=""
# Optionnel : CDN où sont hébergées les photos (fichiers <id>.jpg). Vide = chargement depuis Unsplash.
NEXT_PUBLIC_MEDIA_BASE=""
